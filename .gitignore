# ==========================================
# 1. API Keys, Environment & Credentials
# ==========================================
.env
.env.*
*.pem
*.key
secrets.json

# ==========================================
# 2. Virtual Environments
# ==========================================
.venv/
.venv_wsl/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 3. Heavy ML Artifacts, Models & Datasets
# ==========================================
# Ignore large dataset JSONs and raw pulls
data/raw/
data/processed/
data/trapped/
*.jsonl

# Ignore trained LoRA adapter weights & checkpoints
adapters/
checkpoints/
models/
runs/
wandb/

# PyTorch / HuggingFace Model Weights
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.h5

# HuggingFace local cache
.cache/
huggingface/

# ==========================================
# 4. Python Cache & Build Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv_thesis/
unsloth_compiled_cache/

# ==========================================
